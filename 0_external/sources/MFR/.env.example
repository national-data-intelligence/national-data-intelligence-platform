# MFR FHIR replica · environment knobs
# Copy to .env and edit if needed.

# Persistent data directory on the host. Defaults to ./data which puts
# everything inside this folder (handy for inspection); switch to a path on
# /data/warehouse/ if you'd rather pin it to the warehouse data disk.
MFR_DATA_DIR=./data

# H2 password (left empty matches the JPA Server defaults). Override if you
# expose this server to anything other than localhost / nhdw_net.
MFR_DB_PASSWORD=

# Base URL the seeder + verifier talk to.
MFR_FHIR_BASE=http://127.0.0.1:8093/fhir
