# Climate ingestor — source + lake config.
# Source: the external Climate API replica (0_external/sources/Climate).
CLIMATE_API_BASE_URL=http://host.k3d.internal:8095
CLIMATE_PAGE_SIZE=10000
CLIMATE_TIMEOUT=60
# ISO-date floor on week_start for the first run (empty = full history).
CLIMATE_INITIAL_UPDATED_SINCE=
CLIMATE_DEV_MAX_ROWS=0

# MinIO data lake (in-cluster).
MINIO_ENDPOINT=http://minio-datalake.nhdw.svc.cluster.local:9000
MINIO_REGION=et-addis-1
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_RAW_BUCKET=nhdw-raw

DLT_PIPELINE_NAME=climate
