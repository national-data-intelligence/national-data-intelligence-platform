# Postgres vault — engine config + per-user passwords.
# Copy to .env (gitignored) and fill in the changeme- values.

# ── Database + admin user (Postgres superuser inside this container) ──────
POSTGRES_DB=nhdw_vault
POSTGRES_ADMIN_USER=vault_admin
POSTGRES_ADMIN_PASSWORD=changeme-admin

# ── Service users (must satisfy reasonable strength) ─────────────────────
# Used by 2_pipelines/vault/bridge/ (CH→PG sync).
LANDING_WRITER_PASSWORD=changeme-landing

# Used by 2_pipelines/vault/ dbt-postgres + AutomateDV models.
VAULT_WRITER_PASSWORD=changeme-vault

# Used by CloudBeaver, base dashboard, Superset (read-only on business vault).
BI_READER_PASSWORD=changeme-reader

# ── Ops DB (nhdw_ops — control plane: identity cache, saved queries,
#         export registry, workshop artifacts, gateway/policy audit) ───────
OPS_DB_NAME=nhdw_ops
OPS_WRITER_PASSWORD=changeme-ops-writer
OPS_GATEWAY_PASSWORD=changeme-ops-gateway
OPS_READER_PASSWORD=changeme-ops-reader

# ── Data dir on the managed disk ──────────────────────────────────────────
VAULT_DATA_DIR=/data/storage/postgres
