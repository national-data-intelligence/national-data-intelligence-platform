GATEWAY_URL=http://nhdw-gateway:8000

# DEV_AUTH=true   → bypass OIDC, inject DEV_MOCK_USER + DEV_MOCK_ROLE on
#                   every /gw/* call. Use for local-bootstrap workflow.
# DEV_AUTH=false  → require Keycloak login (workshop client in moh-staff
#                   realm). Set KEYCLOAK_* + OIDC_CLIENT_SECRET below.
DEV_AUTH=true
DEV_MOCK_USER=a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
DEV_MOCK_ROLE=R-CONS-SCI

# Session cookie signing. ROTATE in production.
SESSION_SECRET=dev-only-change-me

# Keycloak (only honored when DEV_AUTH=false).
KEYCLOAK_BASE=http://keycloak:8080
KEYCLOAK_PUBLIC_BASE=http://127.0.0.1:8090
OIDC_REALM=moh-staff
OIDC_CLIENT_ID=workshop
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:8085/callback
APP_BASE=http://127.0.0.1:8085
