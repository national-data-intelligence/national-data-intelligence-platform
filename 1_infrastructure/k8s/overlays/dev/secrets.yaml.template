# ─────────────────────────────────────────────────────────────────────────
# secrets.yaml.template — the COMMITTED scaffold of every k8s Secret the deploy
# needs. bundle/scripts/gen-secrets.sh renders this into the gitignored
# overlays/dev/secrets.yaml, substituting two kinds of placeholder token:
#   * a "generated" token  (G_ prefix, double-underscore wrapped) → a fresh random
#     hex, one value per UNIQUE token; the same token reused below shares ONE value
#     so a cross-referenced credential can never drift. The FERNET one becomes a
#     valid urlsafe-base64 Fernet key.
#   * a "real" token (REAL: prefix with a NAME and a |default) → the real
#     third-party credential from env $NAME, else preserved from an existing
#     secrets.yaml, else the changeme default shown. Consumers of these are
#     optional, so an absent/placeholder value degrades gracefully.
# Fixed non-secret values (usernames, hosts) are literal.
#
# This file is SAFE to commit — it contains NO secret material. The generator
# never overwrites an existing secrets.yaml, so it can't rotate a live cluster's
# passwords out from under its already-initialised databases.
# ─────────────────────────────────────────────────────────────────────────
apiVersion: v1
kind: Secret
metadata: { name: minio-secrets, namespace: nhdw }
type: Opaque
stringData:
  ROOT_USER: "nhdw_root"
  ROOT_PASSWORD: "__G_MINIO_ROOT__"
  # Least-privilege project-sync service user (JupyterLab labs): minio-init
  # scopes it to nhdw-artifacts/projects/* — these creds ride inside user
  # notebook pods, so they must never be the root pair.
  PROJECT_SYNC_ACCESS_KEY: "jupyter-sync"
  PROJECT_SYNC_SECRET_KEY: "__G_PROJECT_SYNC__"
---
