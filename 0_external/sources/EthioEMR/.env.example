# Source: EthioEMR (OpenMRS / Bahmni-family)
# Purpose: Replica of the Ethiopia MoH Electronic Medical Records system.
# Real-world equivalent connection:
#   MySQL  → facility-internal host:3306 (CDC) or VPN-tunneled
#   OpenMRS REST  → https://emr.{facility}.moh.gov.et/openmrs/ws/rest/v1
#   FHIR R4 API   → https://emr.{facility}.moh.gov.et/openmrs/ws/fhir2/R4
#
# Replace these values in a sibling .env file (gitignored).

# ── MySQL container (the OpenMRS / Bahmni backend store) ──
ETHIOEMR_MYSQL_ROOT_PASSWORD=changeme-strong-root-password
ETHIOEMR_DB_NAME=openmrs

# Read-only service user — used by the ingestor (CDC / direct extract)
ETHIOEMR_READER_USER=ingestor
ETHIOEMR_READER_PASSWORD=changeme-reader-password

# Admin user (writes; only for ops)
ETHIOEMR_ADMIN_USER=openmrs_admin
ETHIOEMR_ADMIN_PASSWORD=changeme-admin-password

# ── OpenMRS web app (REST + FHIR R4) ──
# These match the seeded admin user inside the OpenMRS DB; do not change unless
# you re-seed users in the dump.
OPENMRS_DB_HOST=ethioemr-mysql
OPENMRS_DB_PORT=3306
OPENMRS_DB_NAME=openmrs
OPENMRS_DB_USER=openmrs
OPENMRS_DB_PASSWORD=changeme-openmrs-app-password

# ── Volume / data location ──
ETHIOEMR_DATA_DIR=/data/sources/EthioEMR/data

# ── Public endpoints advertised to the ingestor ──
# MySQL (for CDC / direct DB extraction)
ETHIOEMR_MYSQL_HOST=127.0.0.1
ETHIOEMR_MYSQL_PORT=33306

# OpenMRS REST + FHIR (for OpenFn / FHIR-based extraction)
ETHIOEMR_OPENMRS_HOST=127.0.0.1
ETHIOEMR_OPENMRS_PORT=8081
ETHIOEMR_OPENMRS_BASE_URL=http://127.0.0.1:8081/openmrs

# ── Clinical-data synthesis controls (scripts/synthesize.py) ──
# The OpenMRS dump ships only concepts + Bahmni config. We synthesize realistic
# patient/visit/encounter/obs rows on top of the real concept catalog and
# Ethiopian MFR facilities.
ETHIOEMR_SYNTH_LOCATION_COUNT=30
ETHIOEMR_SYNTH_PROVIDER_COUNT=20
ETHIOEMR_SYNTH_PATIENT_COUNT=500
ETHIOEMR_SYNTH_YEARS_HISTORY=3
ETHIOEMR_SYNTH_SEED=42
