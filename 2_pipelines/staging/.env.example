# dbt-clickhouse staging — connection to the engine in 3_storage/clickhouse/.

# ── ClickHouse target ──────────────────────────────────────────────────────
CH_HOST=clickhouse
CH_PORT=8123
CH_USER=staging_writer
# Pull from 3_storage/clickhouse/.env  CLICKHOUSE_STAGING_PASSWORD.
CH_PASSWORD=changeme-must-match-clickhouse-staging-password
CH_SCHEMA=nhdw_staging
