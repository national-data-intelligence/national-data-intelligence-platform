# Source: HCMIS WDM (formerly Vitas)
# Purpose: Replica of the Ethiopia EPSS Health Commodity Management Information
#          System — Warehouse Data Management. Operational system for vaccine and
#          medical-supply logistics across EPSS centres + hubs + facilities.
#
# Real-world equivalent connection:
#   SQL Server  → jdbc:sqlserver://hcmis.epss.gov.et:1433;databaseName=HCMISWDM
#                 (or via SSH tunnel to a VM hosting the SQL Server instance)
#
# Replace these values in a sibling .env file (gitignored).

# ── SQL Server container (sa = admin; used only by init / restore.sh) ──
HCMISWDM_SA_PASSWORD=ChangeMe-MUST-be-strong-Aa1!

# ── Read-only service users used by the ingestor ──
# Matches the prior team's naming so existing OpenFn jobs continue to work.
HCMISWDM_NSCD_READER_PASSWORD=changeme-nscd-reader
HCMISWDM_OPENFN_READER_PASSWORD=ChangeMe-openfn-Aa1!

# ── Volume / data location ──
HCMISWDM_DATA_DIR=/data/sources/HCMISWDM/data

# ── Public endpoint advertised to the ingestor ──
HCMISWDM_HOST=127.0.0.1
HCMISWDM_PORT=1433
HCMISWDM_DATABASE=HCMISWDM

# ── Synthesis controls (used by scripts/synthesize.py and
#    scripts/synthesize_analytics.py) ──
# How many facilities to populate. "all" loads every facility from
# _shared/_build/facilities.json (893 today). A numeric value samples that
# many rows (clamped to the population size).
SYNTH_FACILITY_COUNT=all
# Years of monthly history to generate (e.g. 3 → 36 months back from today).
SYNTH_YEARS_HISTORY=3
# Random seed (defaults to the entity-model random_seed: 20260624).
SYNTH_RANDOM_SEED=20260624
# Hard cap on Fact.DailyRecord rows. Natural count at 19 hubs × 35
# commodities × 3 modes × 36 months ≈ 72k.
SYNTH_FACT_DAILY_CAP=80000
