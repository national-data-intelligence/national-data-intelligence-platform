        <mxCell id="B_obs" value="OBSERVABILITY" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#EFEBE9;strokeColor=#5D4037;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#3E2723;verticalAlign=top;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="988" width="1920" height="86" as="geometry"/></mxCell>
