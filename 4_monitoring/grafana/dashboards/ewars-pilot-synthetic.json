      "title": "SYNTHETIC \u2014 Alarm signal: observed vs expected cases \u00b7 $woreda (2024)",
      "description": "EWARS-CSD style alarm-signal chart. Synthetic PoC data, not real surveillance.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bfp40bxmh7i0wa"
          },
          "rawSql": "SELECT\n  TO_DATE(p.year||'-'||LPAD((p.week)::text,2,'0')||'-1','IYYY-IW-ID') AS time,\n  m.weekly_hospitalised_cases AS \"Observed cases\",\n  p.pred_cases_mean              AS \"Expected (predicted mean)\",\n  p.pred_cases_lwr95            AS \"Lower 95%\",\n  p.pred_cases_upr95            AS \"Upper 95%\",\n  p.alarm_threshold             AS \"Alarm threshold\",\n  CASE WHEN p.alarm_flag=1 THEN p.pred_cases_mean END AS \"Alarm fired\"\nFROM ewars.ewars_predictions p\nLEFT JOIN ewars.mart_ewars_input m\n  ON m.district=p.district AND m.year=p.year AND m.week=p.week\nWHERE p.data_provenance='synthetic' AND p.run_id=(SELECT max(run_id) FROM ewars.ewars_predictions WHERE data_provenance='synthetic')\n  AND p.district = $woreda\nORDER BY 1",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
