# DHIS2 — Ethiopia NHDW source system. Credential & connection record.
#
# Copy to .env (gitignored) and fill in real values. NOTE: docker-compose.yml
# currently holds the DB values inline; this file is the single source of truth
# for credentials and is consumed by scripts and human operators.

# ── Public endpoint (nginx + Let's Encrypt TLS — do not change the port) ──
DHIS2_BASE_URL=https://ethio-dhis2.dataforimplementation.org
# In-network on nhdw_net (alias kept for the ingestor):
DHIS2_INTERNAL_URL=http://dhis2-web:8080

# ── Admin (privileged; UI + API administration) ──
DHIS2_ADMIN_USER=admin
DHIS2_ADMIN_PASSWORD=changeme-strong-admin-password

# ── Read/export service account (OpenFn + internal ingestor) ──
DHIS2_READER_USER=openfn
DHIS2_READER_PASSWORD=changeme-reader-password

# ── PostgreSQL backend (PostGIS), exposed on 127.0.0.1 only ──
DHIS2_DB_HOST=127.0.0.1
DHIS2_DB_PORT=5433
DHIS2_DB_NAME=dhis2
DHIS2_DB_USER=dhis
# INVARIANT: this drives dhis2-db POSTGRES_PASSWORD on fresh init, and MUST match
# config/dhis.conf connection.password (the static conf DHIS2-web actually reads —
# the DHIS2_DATABASE_PASSWORD env is ignored while dhis.conf is mounted). Keep in sync.
DHIS2_DB_PASSWORD=dhis

# ── Data location (the 500 GB data disk) ──
DHIS2_DATA_DIR=/data/warehouse/dhis2
