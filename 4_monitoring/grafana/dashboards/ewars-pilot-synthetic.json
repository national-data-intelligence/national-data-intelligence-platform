      "title": "SYNTHETIC \u2014 Alarm-probability heatmap (woreda \u00d7 week, 2024)",
      "description": "Each row = a woreda, each cell = that week's alarm probability. Synthetic PoC data.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bfp40bxmh7i0wa"
          },
          "rawSql": "SELECT\n  TO_DATE(year||'-'||LPAD((week)::text,2,'0')||'-1','IYYY-IW-ID') AS time,\n  max(CASE WHEN district=18 THEN alarm_prob END) AS \"Aw-Bare\",\n  max(CASE WHEN district=13 THEN alarm_prob END) AS \"Bedeno\",\n  max(CASE WHEN district=11 THEN alarm_prob END) AS \"Deder\",\n  max(CASE WHEN district=1 THEN alarm_prob END) AS \"Dera (AM)\",\n  max(CASE WHEN district=16 THEN alarm_prob END) AS \"Gedeb Asasa\",\n  max(CASE WHEN district=9 THEN alarm_prob END) AS \"Gemechis\",\n  max(CASE WHEN district=14 THEN alarm_prob END) AS \"Girawa\",\n  max(CASE WHEN district=3 THEN alarm_prob END) AS \"Goma\",\n  max(CASE WHEN district=15 THEN alarm_prob END) AS \"Hambela Wamena\",\n  max(CASE WHEN district=20 THEN alarm_prob END) AS \"Hawassa town\",\n  max(CASE WHEN district=2 THEN alarm_prob END) AS \"Kersa (Jimma)\",\n  max(CASE WHEN district=17 THEN alarm_prob END) AS \"Kokosa\",\n  max(CASE WHEN district=8 THEN alarm_prob END) AS \"Kuni /Oda Bultum\",\n  max(CASE WHEN district=12 THEN alarm_prob END) AS \"Melka Balo\",\n  max(CASE WHEN district=7 THEN alarm_prob END) AS \"Mesela /Shen Duggoo\",\n  max(CASE WHEN district=10 THEN alarm_prob END) AS \"Meta\",\n  max(CASE WHEN district=5 THEN alarm_prob END) AS \"Omo Nada\",\n  max(CASE WHEN district=4 THEN alarm_prob END) AS \"Seka Chekorsa\",\n  max(CASE WHEN district=6 THEN alarm_prob END) AS \"Shirka\",\n  max(CASE WHEN district=19 THEN alarm_prob END) AS \"Sodo Zuria\"\nFROM ewars.ewars_predictions\nWHERE data_provenance='synthetic' AND run_id=(SELECT max(run_id) FROM ewars.ewars_predictions WHERE data_provenance='synthetic')\nGROUP BY year, week\nORDER BY 1",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true
        }
