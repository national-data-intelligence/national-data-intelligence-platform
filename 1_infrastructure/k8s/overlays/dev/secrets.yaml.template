# MinIO console native-OIDC client secret (#30). SAME value read by the
# keycloak-seed Job (creates the `minio-console` client in privileged-ops) and
# the MinIO server (MINIO_IDENTITY_OPENID_CLIENT_SECRET, completes the code
# exchange) — one shared token so it can never drift.
# ── SeaweedFS (replaces minio-datalake; 3_storage/seaweedfs/README.md) ──────────
# The ENTIRE identity surface — what `mc admin user/policy` did on MinIO — is this
# one file, mounted into the S3 gateway. Cross-refs are deliberate: accounts whose
# consumers already hold a credential REUSE the same generated token, so cutover
# is endpoint-only and no consumer Secret changes on the day. Rotation is a
# separate, later step (Phase 8), not something to do on cutover day.
#   ADMIN          ↔ minio-secrets ROOT_*          (ClickHouse named collection, DAGs, ingestors)
#   mlflow         ↔ mlflow-secrets S3_SECRET_KEY  (= __G_MINIO_ROOT__ today, same cross-ref)
#   jupyter-sync   ↔ minio-secrets PROJECT_SYNC_*  (rides inside user notebook pods)
# Grant syntax: prefix grants MUST use the `bucket/prefix/*` glob form — the bare
# form fails CLOSED (Phase 1, Q6). "Write" includes delete (Phase 1, Q6b).
apiVersion: v1
kind: Secret
metadata: { name: seaweedfs-secrets, namespace: nhdw }
type: Opaque
stringData:
  ADMIN_ACCESS_KEY: "nhdw_root"
  ADMIN_SECRET_KEY: "__G_MINIO_ROOT__"
  # Filer metadata store role in postgres-vault. Cross-ref: postgres-vault-secrets
  # SEAWEEDFS_FILER_DB_PASSWORD (the init script creates the role with it).
  FILER_DB_PASSWORD: "__G_SEAWEED_FILER_DB__"
  identities.json: |
    {
      "identities": [
        {
          "name": "nhdw_root",
          "credentials": [{ "accessKey": "nhdw_root", "secretKey": "__G_MINIO_ROOT__" }],
          "actions": ["Admin", "Read", "Write", "List", "Tagging"]
        },
        {
          "name": "mlflow",
          "credentials": [{ "accessKey": "mlflow", "secretKey": "__G_MINIO_ROOT__" }],
          "actions": ["Read:nhdw-artifacts", "Write:nhdw-artifacts", "List:nhdw-artifacts", "Tagging:nhdw-artifacts"]
        },
        {
          "name": "jupyter-sync",
          "credentials": [{ "accessKey": "jupyter-sync", "secretKey": "__G_PROJECT_SYNC__" }],
          "actions": ["Read:nhdw-artifacts/projects/*", "Write:nhdw-artifacts/projects/*", "List:nhdw-artifacts/projects/*"]
        },
        {
          "name": "anonymous",
          "actions": ["Read:nhdw-static", "List:nhdw-static"]
        }
      ]
    }
---
