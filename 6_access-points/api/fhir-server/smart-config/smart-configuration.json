{
  "issuer": "http://127.0.0.1:8090/realms/moh-staff",
  "authorization_endpoint": "http://127.0.0.1:8090/realms/moh-staff/protocol/openid-connect/auth",
  "token_endpoint": "http://127.0.0.1:8090/realms/moh-staff/protocol/openid-connect/token",
  "introspection_endpoint": "http://127.0.0.1:8090/realms/moh-staff/protocol/openid-connect/token/introspect",
  "revocation_endpoint": "http://127.0.0.1:8090/realms/moh-staff/protocol/openid-connect/revoke",
  "scopes_supported": [
    "openid",
    "fhirUser",
    "launch/patient",
    "patient/*.read",
    "user/*.read",
    "system/*.read",
    "system/*.write",
    "offline_access"
  ],
  "response_types_supported": ["code"],
  "grant_types_supported": ["authorization_code", "client_credentials", "refresh_token"],
  "token_endpoint_auth_methods_supported": [
    "client_secret_basic",
    "client_secret_post"
  ],
  "capabilities": [
    "launch-standalone",
    "client-confidential-symmetric",
    "sso-openid-connect",
    "permission-patient",
    "permission-user"
  ],
  "code_challenge_methods_supported": ["S256"]
}
