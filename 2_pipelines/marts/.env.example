# dbt-postgres marts — connection to 3_storage/postgres/.

PG_HOST=postgres-vault
PG_PORT=5432
PG_DATABASE=nhdw_vault
PG_USER=vault_writer
# Pull from 3_storage/postgres/.env  VAULT_WRITER_PASSWORD.
PG_PASSWORD=changeme-vault-writer
# Profile-level schema is unused — every model overrides via +schema.
PG_SCHEMA=bi_facility
