# OpenLMIS ingestor — environment.
# Copy to .env (gitignored) and fill in the changeme- values.

# ── OpenLMIS source ─────────────────────────────────────────────────────────
# host.docker.internal:8086 matches nginx's VIRTUAL_HOST allowlist exactly
# (any other Host header — e.g. the openlmis-nginx nhdw_net alias, or
# host.k3d.internal from the cluster — falls into the 20 r/s rate-limited
# bucket; fine for this sequential ingestor, but the allowlisted name is
# faster). Resolves on the Windows host AND inside Docker Desktop containers.
OPENLMIS_BASE_URL=http://host.docker.internal:8086
# Demo-data account + OAuth2 client (baked into the upstream demo dataset —
# see 1_external/sources/OpenLMIS/README.md §4).
OPENLMIS_USER=administrator
OPENLMIS_PASSWORD=password
OPENLMIS_OAUTH_CLIENT=user-client
OPENLMIS_OAUTH_SECRET=changeme
# To swap to a real national eLMIS:
#   OPENLMIS_BASE_URL=https://elmis.<country-domain>
#   plus MoH-issued user/password + registered OAuth client.

# ── OpenLMIS API behavior ───────────────────────────────────────────────────
# Spring-Data page size for paginated endpoints.
OPENLMIS_PAGE_SIZE=200
# Request timeout (seconds).
OPENLMIS_TIMEOUT=120

# ── MinIO data lake ─────────────────────────────────────────────────────────
MINIO_ENDPOINT=http://minio-datalake:9000
MINIO_REGION=et-addis-1
MINIO_ACCESS_KEY=nhdw_ingestor
MINIO_SECRET_KEY=changeme-must-match-data-lake-INGESTOR_SECRET_KEY
MINIO_RAW_BUCKET=nhdw-raw

# ── Pipeline identity ───────────────────────────────────────────────────────
DLT_PIPELINE_NAME=openlmis

# ── Legacy eLMIS v2 historical DB (the `history` pipeline → elmis_hist/) ────
# In-network: the compose alias on nhdw_net; from k3d: host.k3d.internal.
OPENLMIS_HIST_HOST=openlmis-hist-db
OPENLMIS_HIST_PORT=5432
OPENLMIS_HIST_DB=elmis_historical
OPENLMIS_HIST_USER=elmis_reader
OPENLMIS_HIST_PASSWORD=changeme-elmis-hist-reader
