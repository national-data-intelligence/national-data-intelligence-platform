# Source: DHIS2 (District Health Information Software 2)
# Purpose: Replica of Ethiopia's national aggregate health-reporting platform.
# Real-world equivalent connection:
#   DHIS2 Web API → https://ethio-dhis2.dataforimplementation.org/api/<resource>
#                   (HTTPS, Basic / OAuth, paginated JSON)
#   PostgreSQL    → only reachable inside the DHIS2 VM; direct DB extract by
#                   special arrangement only.

# ── DHIS2 Java app ──
DHIS2_VERSION=2.40.4
DHIS2_ADMIN_USER=admin
DHIS2_ADMIN_PASSWORD=district     # default for DHIS2 demo database; rotate after first login

# ── PostgreSQL backend (PostGIS) ──
DHIS2_DB_HOST=dhis2-db
DHIS2_DB_PORT=5432
DHIS2_DB_NAME=dhis2
DHIS2_DB_USER=dhis
DHIS2_DB_PASSWORD=changeme-strong-dhis-password

# ── Volume / data location ──
DHIS2_DATA_DIR=/data/sources/DHIS2/data

# ── Public endpoints advertised to the ingestor ──
DHIS2_HOST=127.0.0.1
DHIS2_PORT=8080
DHIS2_BASE_URL=http://127.0.0.1:8080
DHIS2_PG_HOST=127.0.0.1
DHIS2_PG_PORT=5433

# ── Demo DB seed configuration ──
# Default demo DB is the official DHIS2 Sierra Leone reference DB. It contains
# ~3,500 org units, hundreds of data elements across HIV/TB/Malaria/MNCH/EPI
# programs, and ~10 years of data values. The API shape is identical to
# production Ethiopia DHIS2.
#
# For a true Ethiopian seed, replace with a real Ethiopia DHIS2 pgdump file
# placed at sample-data/dhis2_ethiopia.pgdump and re-run scripts/restore.sh.
DHIS2_DEMO_DB_URL=https://databases.dhis2.org/sierra-leone/2.40.4/dhis2-db-sierra-leone.sql.gz
DHIS2_DEMO_DB_VARIANT=sierra-leone
