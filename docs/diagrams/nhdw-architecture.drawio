<diagram id="02___identity___token_exchange" name="02 · Identity &amp; Token Exchange">
  <mxGraphModel dx="1700" dy="1100" grid="1" gridSize="10"
                guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1"
                pageWidth="1500" pageHeight="900" math="0" shadow="0">
    <root>
      <mxCell id="0"/>
      <mxCell id="1" parent="0"/>
      <mxCell id="a_title" value="Sign-in &amp; OpenBao token exchange" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#0F1F3C;" vertex="1" parent="1"><mxGeometry x="450" y="20" width="600" height="36" as="geometry"/></mxCell>
      <mxCell id="a_sub" value="OIDC against Keycloak → flat 'roles' claim → JWT-keycloak login → short-TTL Postgres credential" style="text;html=1;align=center;fontSize=11;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="200" y="56" width="1100" height="22" as="geometry"/></mxCell>
      <mxCell id="user" value="Browser&#10;(Staff user)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F1F3C;strokeWidth=2;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="160" height="60" as="geometry"/></mxCell>
      <mxCell id="ibi" value="Internal BI :8087" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6ECF6;strokeColor=#1A3057;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="280" y="120" width="200" height="60" as="geometry"/></mxCell>
      <mxCell id="kc" value="Keycloak :8090&#10;moh-staff realm" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#9F1239;strokeWidth=1.5;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="560" y="120" width="240" height="60" as="geometry"/></mxCell>
      <mxCell id="bao" value="OpenBao :8200&#10;jwt-keycloak auth" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#9F1239;strokeWidth=1.5;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="120" width="240" height="60" as="geometry"/></mxCell>
      <mxCell id="pg" value="postgres-vault :5432" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#FEF7E7;strokeColor=#8B4A17;strokeWidth=1.5;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1160" y="120" width="240" height="60" as="geometry"/></mxCell>
      <mxCell id="loki" value="Loki :3100" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#9F1239;strokeWidth=1.5;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1160" y="220" width="240" height="50" as="geometry"/></mxCell>
      <mxCell id="a_e1" value="1. GET / (no session)" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jettySize=auto;orthogonalLoop=1;strokeColor=#1A3057;strokeWidth=1.5;fontSize=9;fontColor=#1A3057;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="ibi"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="a_n1" value="2. 307 → /login" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="230" y="200" width="320" height="30" as="geometry"/></mxCell>
      <mxCell id="a_e2" value="3. 307 redirect to KC" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jettySize=auto;orthogonalLoop=1;strokeColor=#1A3057;strokeWidth=1.5;fontSize=9;fontColor=#1A3057;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="ibi" target="user"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="a_e3" value="4. GET /auth?response_type=code" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jettySize=auto;orthogonalLoop=1;strokeColor=#1A3057;strokeWidth=1.5;fontSize=9;fontColor=#1A3057;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="kc"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="a_e4" value="5. login form + 302 ?code=..." style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jettySize=auto;orthogonalLoop=1;strokeColor=#1A3057;strokeWidth=1.5;fontSize=9;fontColor=#1A3057;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="kc" target="user"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="a_e5" value="6. /callback?code=..." style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jettySize=auto;orthogonalLoop=1;strokeColor=#1A3057;strokeWidth=1.5;fontSize=9;fontColor=#1A3057;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="ibi"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="a_e6" value="7. token-endpoint exchange (code → JWT)" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jettySize=auto;orthogonalLoop=1;strokeColor=#1A3057;strokeWidth=1.5;fontSize=9;fontColor=#1A3057;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ibi" target="kc"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="a_e7" value="8. access_token w/ roles · geographies · programs" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jettySize=auto;orthogonalLoop=1;strokeColor=#1A3057;strokeWidth=1.5;fontSize=9;fontColor=#1A3057;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="kc" target="ibi"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="a_e8" value="9. Set-Cookie session + 302 /" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jettySize=auto;orthogonalLoop=1;strokeColor=#1A3057;strokeWidth=1.5;fontSize=9;fontColor=#1A3057;exitX=0.2;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ibi" target="user"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="a_box" value="▸ At first data request:" style="text;html=1;fontSize=11;fontStyle=2;fontColor=#0F1F3C;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="320" width="400" height="24" as="geometry"/></mxCell>
      <mxCell id="a_e10" value="10. POST /v1/auth/jwt-keycloak/login&#10;body = {role: r-cons-ana, jwt: &lt;KC access_token&gt;}" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jettySize=auto;orthogonalLoop=1;strokeColor=#9F1239;strokeWidth=1;fontSize=9;dashed=1;fontColor=#9F1239;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="ibi" target="bao"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="a_e11" value="11. verify JWT (JWKS)" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jettySize=auto;orthogonalLoop=1;strokeColor=#1A3057;strokeWidth=1.5;fontSize=9;fontColor=#1A3057;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="bao" target="kc"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="a_e12" value="12. child token + lease" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jettySize=auto;orthogonalLoop=1;strokeColor=#9F1239;strokeWidth=1;fontSize=9;dashed=1;fontColor=#9F1239;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="bao" target="ibi"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="a_e13" value="13. GET /v1/database/creds/postgres-vault-bi-reader" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jettySize=auto;orthogonalLoop=1;strokeColor=#9F1239;strokeWidth=1;fontSize=9;dashed=1;fontColor=#9F1239;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ibi" target="bao"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="a_e14" value="14. {username,password,ttl=10m}" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jettySize=auto;orthogonalLoop=1;strokeColor=#9F1239;strokeWidth=1;fontSize=9;dashed=1;fontColor=#9F1239;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bao" target="ibi"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="a_e15" value="15. CREATE pool · SELECT bi_facility.*" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jettySize=auto;orthogonalLoop=1;strokeColor=#047857;strokeWidth=2;fontSize=9;fontColor=#065F46;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ibi" target="pg"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="a_e20" value="AuditEvent { user, role, resource, outcome }" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jettySize=auto;orthogonalLoop=1;strokeColor=#C9A04D;strokeWidth=1;fontSize=9;dashed=1;fontColor=#854D0E;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ibi" target="loki"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="a_note1" value="OpenBao verifies the KC JWT against its JWKS.&#10;bound_claims = { roles: ['R-CONS-ANA'] } — that's why P5.1.1 needed a FLAT 'roles' claim." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="450" y="320" width="600" height="70" as="geometry"/></mxCell>
      <mxCell id="a_lg_bg" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#CBD5E1;strokeWidth=1;dashed=1;fontSize=10;fontColor=#64748B;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="50" y="60" width="300" height="110" as="geometry"/></mxCell>
      <mxCell id="a_lg_sync" value="▬ sync request (HTTP / RPC)" style="text;html=1;fontSize=10;fontColor=#1A3057;align=left;" vertex="1" parent="1"><mxGeometry x="62" y="82" width="280" height="16" as="geometry"/></mxCell>
      <mxCell id="a_lg_data" value="▬ data flow (read / write)" style="text;html=1;fontSize=10;fontColor=#047857;align=left;" vertex="1" parent="1"><mxGeometry x="62" y="102" width="280" height="16" as="geometry"/></mxCell>
