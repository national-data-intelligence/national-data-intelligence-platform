# Fayda replica — ISOLATED SMTP config TEMPLATE (committed; placeholders only).
#
# Copy this to `0_external/fayda/.env` (gitignored) and fill in real values, then
# `docker compose up -d --build`. Fayda owns its verification email end-to-end and
# sends OTP codes from ITS OWN SMTP — deliberately separate from the NHDW gateway's
# smtp-secrets. The same underlying Gmail account is fine; the creds are just
# COPIED here into Fayda's isolated config rather than shared.
#
# docker-compose.yml auto-loads ./.env and substitutes these into the container's
# environment. With SMTP unset, the OTP is still generated + logged (see the
# [fayda][DEV-ONLY] log line) but no email is delivered.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=changeme@gmail.com
SMTP_PASS=changeme-app-password
SMTP_FROM=Fayda Verification <changeme@gmail.com>
