# EthioEMR ingestor — environment.
#
# The ingestor reads the facility OpenMRS/Bahmni EMR **directly over MySQL** and
# reshapes person/patient/patient_identifier/encounter/visit/obs rows into
# FHIR-shaped Parquet. (The OpenMRS web app is no longer run — a real EMR's
# native integration surface is CDC/JDBC.)

# ── EthioEMR MySQL source ───────────────────────────────────────────────────
# From an in-cluster (k3d) pod, the external compose replica is reached via the
# host gateway on its published port (see 0_external/sources/EthioEMR/docker-compose.yml
# → 0.0.0.0:33306). Locally you can point at 127.0.0.1:33306.
ETHIOEMR_MYSQL_HOST=host.k3d.internal
ETHIOEMR_MYSQL_PORT=33306
ETHIOEMR_MYSQL_DB=openmrs

# Read-only ingestor user provisioned by 0_external/sources/EthioEMR/scripts/restore.sh
# (GRANT SELECT + REPLICATION on openmrs.*). Password = ETHIOEMR_READER_PASSWORD
# from the source stack's .env.
ETHIOEMR_MYSQL_USER=ingestor
ETHIOEMR_MYSQL_PASSWORD=changeme-must-match-ethioemr-READER_PASSWORD

# Resources to ingest (comma-separated). Each becomes one table in nhdw-raw:
# Patient→patient, Encounter→encounter, Observation→observation.
ETHIOEMR_MYSQL_RESOURCES=Patient,Encounter,Observation

# Connection timeout (seconds) and per-fetch batch size for the obs stream.
ETHIOEMR_MYSQL_TIMEOUT=120
ETHIOEMR_MYSQL_BATCH_SIZE=2000

# Incremental cursor on OpenMRS `date_created` (ISO 8601). We use date_created
# (NOT date_changed — NULL on synthetic rows); anything created before this is
# skipped on the first run.
ETHIOEMR_MYSQL_INITIAL_CURSOR=2020-01-01

# ── MinIO data lake ─────────────────────────────────────────────────────────
MINIO_ENDPOINT=http://seaweedfs-s3.nhdw.svc.cluster.local:8333
MINIO_REGION=et-addis-1
MINIO_ACCESS_KEY=nhdw_ingestor
MINIO_SECRET_KEY=changeme-must-match-data-lake-INGESTOR_SECRET_KEY
MINIO_RAW_BUCKET=nhdw-raw

# ── Pipeline identity ───────────────────────────────────────────────────────
DLT_PIPELINE_NAME=ethioemr
