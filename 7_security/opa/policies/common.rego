# Top-level decision router. PEPs post requests like:
#   POST /v1/data/nhdw/authz/decide
#   { "input": {
#       "user":     { "role": "R-CONS-ANA", ... },
#       "action":   { "verb": "read" },
#       "resource": { "subject": "PT", "granularity": "deidentified",
#                     "sensitivity": "default" },
#       "context":  { "purpose_of_use": "public-health" }
#   }}
#
# Each per-role policy file (generated by scripts/compile.py from
# bundle/roles/) exports `decision`. This file picks the right
# one based on `input.user.role`.
package nhdw.authz

import rego.v1

# Per-role decision lookups. OPA evaluates these one at a time and the
# first matching condition wins.
role_decision := data.nhdw.authz.role_r_pub_anon.decision    if input.user.role == "R-PUB-ANON"
role_decision := data.nhdw.authz.role_r_prod_clin.decision   if input.user.role == "R-PROD-CLIN"
role_decision := data.nhdw.authz.role_r_prod_submit.decision if input.user.role == "R-PROD-SUBMIT"
role_decision := data.nhdw.authz.role_r_dec.decision         if input.user.role == "R-DEC"
# R-DEC is "one role parameterized by scope" (see bundle/roles/r-dec.yaml): a
# National Program Manager and a Regional Health Bureau head ARE R-DEC, they
# differ only by the geography/programme scope pushed via input.context. The RBAC
# seed models those as distinct role codes (R-PD-<prog>, R-RHB-<region>); route
# them to the R-DEC decision so the scope obligation does the actual narrowing.
role_decision := data.nhdw.authz.role_r_dec.decision         if input.user.role == "R-PD-HIV"
role_decision := data.nhdw.authz.role_r_dec.decision         if input.user.role == "R-RHB-OROMIA"
role_decision := data.nhdw.authz.role_r_cons_ana.decision    if input.user.role == "R-CONS-ANA"
role_decision := data.nhdw.authz.role_r_cons_sci.decision    if input.user.role == "R-CONS-SCI"
role_decision := data.nhdw.authz.role_r_cons_res.decision    if input.user.role == "R-CONS-RES"
role_decision := data.nhdw.authz.role_r_cons_prt.decision    if input.user.role == "R-CONS-PRT"
role_decision := data.nhdw.authz.role_r_stew.decision        if input.user.role == "R-STEW"
role_decision := data.nhdw.authz.role_r_ops_eng.decision     if input.user.role == "R-OPS-ENG"
role_decision := data.nhdw.authz.role_r_ops_adm.decision     if input.user.role == "R-OPS-ADM"
role_decision := data.nhdw.authz.role_r_ops_sec.decision     if input.user.role == "R-OPS-SEC"
# R-SUPER is the platform super-user — a TRUE wildcard. Route it to a blanket
# allow rather than the compiled granular policy (which only enumerated raw +
# aggregate for HP/FAC/PRD/PRG and so wrongly denied *deidentified* marts). A
# super-user must never be denied by a missing granularity/subject combination;
# the trust_guard below still applies (a low-trust identity is denied sensitive
# actions even with R-SUPER).
role_decision := {"allow": true, "reason": "R-SUPER — wildcard super-user", "obligations": {}} if input.user.role == "R-SUPER"

# ── scope obligation ──────────────────────────────────────────────────────
# The PEP pushes the caller's granted data scope (ops_identity.user_scope) into
# input.context (geographies/programs/facilities). Emit a row_filter the PEP
# AND-applies to the actual query. A national user (empty context) gets no
# filter; a user scoped to Oromia gets {"geography": ["Oromia"]}. This turns
# granted_scope into ROW-level enforcement, not just UI filtering.
scope_row_filter[dim] := vals if {
	some dim, src in {
		"geography": object.get(input.context, "geographies", []),
		"programme": object.get(input.context, "programs", []),
		"facility": object.get(input.context, "facilities", []),
	}
	vals := src
	count(vals) > 0
}

# ── Column-masking obligation ──────────────────────────────────────────────
# The PEP sends the queried relation's CLASSIFIED columns (from
# ops_perm.column_classification — a denylist, so unclassified columns never
# appear here and stay visible) as
#   input.resource.columns: [{"name": "lat", "sensitivity": "restricted"}, …]
# A classified column is REVEALED only when positively established: the role's
# compiled reveal_sensitivity set (bundle/roles/*.yaml `column_access.reveal`)
# contains its sensitivity — and never for a low-trust identity. Everything
# else lands in `masked_columns`; the PEP transforms each per its mask_class
# (app/masking.py). Same routing table as role_decision, aliases included.
role_reveal := data.nhdw.authz.role_r_pub_anon.reveal_sensitivity    if input.user.role == "R-PUB-ANON"
role_reveal := data.nhdw.authz.role_r_prod_clin.reveal_sensitivity   if input.user.role == "R-PROD-CLIN"
role_reveal := data.nhdw.authz.role_r_prod_submit.reveal_sensitivity if input.user.role == "R-PROD-SUBMIT"
role_reveal := data.nhdw.authz.role_r_dec.reveal_sensitivity         if input.user.role == "R-DEC"
role_reveal := data.nhdw.authz.role_r_dec.reveal_sensitivity         if input.user.role == "R-PD-HIV"
role_reveal := data.nhdw.authz.role_r_dec.reveal_sensitivity         if input.user.role == "R-RHB-OROMIA"
role_reveal := data.nhdw.authz.role_r_cons_ana.reveal_sensitivity    if input.user.role == "R-CONS-ANA"
role_reveal := data.nhdw.authz.role_r_cons_sci.reveal_sensitivity    if input.user.role == "R-CONS-SCI"
role_reveal := data.nhdw.authz.role_r_cons_res.reveal_sensitivity    if input.user.role == "R-CONS-RES"
role_reveal := data.nhdw.authz.role_r_cons_prt.reveal_sensitivity    if input.user.role == "R-CONS-PRT"
role_reveal := data.nhdw.authz.role_r_stew.reveal_sensitivity        if input.user.role == "R-STEW"
role_reveal := data.nhdw.authz.role_r_ops_eng.reveal_sensitivity     if input.user.role == "R-OPS-ENG"
role_reveal := data.nhdw.authz.role_r_ops_adm.reveal_sensitivity     if input.user.role == "R-OPS-ADM"
role_reveal := data.nhdw.authz.role_r_ops_sec.reveal_sensitivity     if input.user.role == "R-OPS-SEC"

# R-SUPER reveals every sensitivity (wildcard, matching its blanket allow).
role_reveal := {"restricted", "privileged"} if input.user.role == "R-SUPER"

# Unknown role ⇒ nothing revealed (fail-closed alongside the default deny).
default role_reveal := set()

_col_revealed(s) if {
	not low_trust # a low-trust identity never sees a classified column clear
	s in role_reveal
}

masked_cols := [c.name |
	some c in object.get(input.resource, "columns", [])
	c.sensitivity != "default"
	not _col_revealed(c.sensitivity)
]

# ── Trust-tier guard (P1.3) ────────────────────────────────────────────────
# A low-trust federated identity (idp_trust == "low" — e.g. a public Google
# login, stamped by the Keycloak mapper) may still READ aggregate/de-identified
# data, but is denied every SENSITIVE action regardless of the role it was
# granted: any write-class verb, and any access to raw patient-level data. Direct
# password logins, EHIA-federated partners, PATs and service principals carry
# idp_trust "high" (absent claim ⇒ high) and are unaffected.
low_trust if input.user.idp_trust == "low"

_sensitive_verbs := {"write", "update", "delete", "manage", "approve",
	"export", "schedule", "trigger", "promote", "generate", "create"}

sensitive_action if input.action.verb in _sensitive_verbs
sensitive_action if object.get(input.resource, "granularity", "") == "raw"

trust_denied if {
	low_trust
	sensitive_action
}

# Default deny — unknown role.
default decide := {"allow": false, "reason": "unknown role"}

# The trust guard takes precedence over the role decision.
decide := {"allow": false, "reason": "low-trust identity denied sensitive action",
	"obligations": {}} if trust_denied

# Merge the scope row_filter and masking obligations into the matched role
# decision. masked_columns rides top-level (the PEP's Decision dataclass
# already parses it there).
decide := object.union(role_decision,
	{"obligations": {"row_filter": scope_row_filter},
		"masked_columns": masked_cols}) if not trust_denied
