# ClickHouse — engine config + MinIO/user secrets.
# Copy to .env (gitignored) and fill in the changeme- values from sibling
# .env files in 3_storage/minio/ and elsewhere.

# ── MinIO (data-lake) credentials used by the nhdw_minio named collection ──
# Reuses the existing transformer service account (read on nhdw-raw, write on
# nhdw-processed; CH only needs the read half). Pull from 3_storage/minio/.env
# (TRANSFORMER_ACCESS_KEY / TRANSFORMER_SECRET_KEY).
MINIO_ENDPOINT=http://seaweedfs-s3.nhdw.svc.cluster.local:8333
MINIO_ACCESS_KEY=nhdw_transformer
MINIO_SECRET_KEY=changeme-from-3_storage/minio/.env-TRANSFORMER_SECRET_KEY

# ── CH service users (must satisfy CH's password policy — letters+digits) ──
# Generated once, kept stable across rebuilds. Used by:
#   staging_writer  → 2_pipelines/staging/   (dbt-clickhouse profile)
#   mart_writer     → 2_pipelines/marts/     (dbt-clickhouse profile, future)
#   bi_reader       → CloudBeaver + base dashboard + Superset
CLICKHOUSE_STAGING_PASSWORD=changeme-staging-password
CLICKHOUSE_MARTS_PASSWORD=changeme-marts-password
CLICKHOUSE_READER_PASSWORD=changeme-reader-password

# ── Data dir on the managed disk ──────────────────────────────────────────
CLICKHOUSE_DATA_DIR=/data/storage/clickhouse
