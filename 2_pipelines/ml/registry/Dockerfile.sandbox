FROM python:3.12-slim
# nhdw/ml-sandbox — pre-baked validator sandbox image used by the
# graduation harness. The smoke test runs:
#   docker run --network=none --read-only --user 65534:65534 \
#       nhdw/ml-sandbox:dev python /workdir/_harness.py
# All commonly used ML deps are installed at build time so the runtime
# container needs zero network access. Keep this list small and stable;
# adding to it should follow a deps-policy decision in ops_artifact.
RUN pip install --no-cache-dir \
        pandas==2.2.3 \
        numpy==2.0.2 \
        statsmodels==0.14.4 \
        scikit-learn==1.5.2 \
        scipy==1.14.1
