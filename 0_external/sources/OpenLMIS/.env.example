# eLMIS (OpenLMIS) — NHDW source system. Credential & connection record.
#
# Copy to .env (gitignored) and fill in real values. The docker-compose.yml reads
# these directly; scripts/restore.sh and scripts/verify.sh `source .env`.

# ── Postgres backend, published on 0.0.0.0:5434 ──
# (5433 is dhis2-db; 5434 is eLMIS. Cluster pods reach it via host.k3d.internal.)
ELMIS_DB_HOST=127.0.0.1
ELMIS_DB_PORT=5434
ELMIS_DB_NAME=elmis
ELMIS_DB_USER=elmis
# INVARIANT: this drives elmis-db POSTGRES_PASSWORD on FRESH INIT ONLY. Changing it
# after the volume exists does NOT change the stored password — you must
# `docker compose down -v` (wipes data, requires a re-restore) or ALTER ROLE.
ELMIS_DB_PASSWORD=changeme-elmis-password

# ── Read-only service account (the in-cluster dlt ingestor connects as this) ──
# Provisioned by scripts/restore.sh. This password MUST match the `source-creds`
# Secret the in-cluster ingestor reads — kept in lock-step by design, same as the
# other sources.
ELMIS_READER_USER=ingestor
ELMIS_READER_PASSWORD=changeme-elmis-reader

# ── Restore artifact ──
# 236 MB gzipped / 1.5 GB uncompressed plain pg_dump. Excluded from the published
# repo (see sample-data/SEED-DATA-NOTICE.md); supply it locally to populate.
ELMIS_DUMP=sample-data/elmis_historical_data_simulated.sql.gz

# ── Postgres image tag ──
# Must be 16.10+ (or 17+): the dump carries \restrict/\unrestrict meta-commands
# that older psql builds reject. restore.sh strips them as a fallback.
ELMIS_PG_IMAGE_TAG=16
