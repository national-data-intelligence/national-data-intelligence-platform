# Source: mBrana — SQL Server (HCMISWCloud schema)
# Purpose: Replica of the Ethiopia MoH / EPSS mBrana cloud platform.
#
# Real-world equivalent connection:
#   SQL Server  → jdbc:sqlserver://mbrana.epss.gov.et:1433;databaseName=HCMISWCloud
#                 (production DB is HCMISWCloud, a SQL Server 2025 database
#                  hosting both the mBrana mobile-cloud schemas (mFlowUSSD,
#                  mBrana, RRF) and shared masters (AdministrativeUnit,
#                  dbo.Institution, Commodity, USM.Environment, etc.).)
#
# Replace these values in a sibling .env file (gitignored).

# ── SQL Server container (sa = admin; only used by init / restore.sh) ──
MBRANA_SA_PASSWORD=ChangeMe-strong-Aa1!

# ── Read-only service users used by the ingestor ──
MBRANA_READER_PASSWORD=changeme-mbrana-reader
MBRANA_OPENFN_PASSWORD=ChangeMe-openfn-Aa1!

# ── Volume / data location ──
MBRANA_DATA_DIR=/data/sources/mBrana/data

# ── Public endpoint advertised to the ingestor ──
# Different port from HCMIS WDM (1433) to keep replicas independent.
MBRANA_HOST=127.0.0.1
MBRANA_PORT=1434
MBRANA_DATABASE=HCMISWCloud

# ── Synthesis controls (used by scripts/synthesize.py) ──
MBRANA_SYNTH_WOREDA_COUNT=50
MBRANA_SYNTH_FACILITIES_PER_WOREDA=15
MBRANA_SYNTH_MONTHS_HISTORY=24
MBRANA_SYNTH_SEED=42
