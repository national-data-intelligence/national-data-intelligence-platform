# NHDW data lake — environment variables.
# Copy to .env (gitignored) and replace every `changeme-*` value.
#
# Generate strong passwords:
#   openssl rand -hex 24

# ── MinIO root account (server admin — used only by the init container) ──
MINIO_ROOT_USER=nhdw_root
MINIO_ROOT_PASSWORD=changeme-strong-root-password
MINIO_BROWSER_REDIRECT_URL=http://127.0.0.1:9101
MINIO_REGION=et-addis-1

# ── Data volume on the managed disk ──
# MUST be on /data/ (the managed disk, not the OS disk).
DATALAKE_DATA_DIR=/data/storage/minio

# ── Service-account credentials ──
# Each account gets a least-privilege policy attached by init/create-buckets.sh:
#
#   nhdw_ingestor    rw on nhdw-raw                                 (used by 2_pipelines/ingestor/*)
#   nhdw_transformer ro on nhdw-raw,        rw on nhdw-processed    (used by dbt / 3_pipelines)
#   nhdw_archiver    ro on nhdw-processed,  rw on nhdw-archive      (used by retention jobs)
#   nhdw_reader      ro on nhdw-processed                           (used by 7_access-points)
#
# Access keys are 3-20 chars; secrets are 8-40 chars (MinIO requirement).

INGESTOR_ACCESS_KEY=nhdw_ingestor
INGESTOR_SECRET_KEY=changeme-ingestor-secret

TRANSFORMER_ACCESS_KEY=nhdw_transformer
TRANSFORMER_SECRET_KEY=changeme-transformer-secret

ARCHIVER_ACCESS_KEY=nhdw_archiver
ARCHIVER_SECRET_KEY=changeme-archiver-secret

READER_ACCESS_KEY=nhdw_reader
READER_SECRET_KEY=changeme-reader-secret
