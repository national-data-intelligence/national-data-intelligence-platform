# MLflow — tracking + registry. Backed by postgres-vault + MinIO.

# Metadata DB — own user inside postgres-vault, schema mlflow_metadata.
MLFLOW_DB_PASSWORD=changeme-mlflow-db

# MinIO — uses the transformer service account (read/write on its bucket).
# Bucket nhdw-ml-artifacts is provisioned by 3_storage/minio/init/create-buckets.sh.
MINIO_ENDPOINT=http://minio-datalake:9000
MINIO_ACCESS_KEY=nhdw_transformer
# Pull from 3_storage/minio/.env  TRANSFORMER_SECRET_KEY.
MINIO_SECRET_KEY=changeme-from-minio-env
