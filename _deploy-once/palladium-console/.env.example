# Copy to .env and fill in. .env is gitignored.
CONSOLE_DB_PASSWORD=change-me
# TLS is terminated by the proxy. Set CONSOLE_DOMAIN to a real DNS name to get a
# genuine certificate and no browser warning at all; an IP or nip.io host gets a
# local-CA certificate, which still warns once.
CONSOLE_DOMAIN=20.84.70.78.nip.io
# 'internal' = Caddy's own CA: real TLS, browser warns once. Works on an IP.
# An email address = a real Let's Encrypt certificate, no warning at all, but
# needs a DNS name and ports 80/443 open to the internet.
CONSOLE_TLS=internal
CONSOLE_HTTP_PORT=8098
CONSOLE_HTTPS_PORT=8443
CONSOLE_PUBLIC_URL=https://20.84.70.78.nip.io:8443
CONSOLE_ENV=prod

# Demo hosts with self-signed certificates. Scoped exception, not a blanket one.
CONSOLE_VERIFY_TLS=true
CONSOLE_INSECURE_HOSTS=20.84.70.78.nip.io

# Single sign-on (optional). Without it people sign in with a console password;
# the first account to register becomes a console admin, and `python -m
# app.adminctl invite` from the host mints a sign-in link if nobody can get in.
KEYCLOAK_PUBLIC_BASE=
KEYCLOAK_REALM=moh-staff
KEYCLOAK_CLIENT_ID=demo-console
KEYCLOAK_CLIENT_SECRET=
