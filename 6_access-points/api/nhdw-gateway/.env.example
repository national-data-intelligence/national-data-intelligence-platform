OPS_GATEWAY_PASSWORD=changeme-ops-gateway
MINIO_ACCESS_KEY=nhdw_gateway
MINIO_SECRET_KEY=changeme-gateway
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9100
TRINO_USER=nhdw-gateway

# ── auth mode ─────────────────────────────────────────────────────────────
# The gateway runs in OIDC mode whenever KEYCLOAK_DISCOVERY_URL is non-empty;
# otherwise it falls back to the DEV_AUTH header-only path (X-Mock-User +
# X-Mock-Role). DO NOT set DEV_AUTH=true in production.
#
# Production example (uncomment one realm — the dashboards behind /gw/* all
# call into this gateway, so the realm chosen here must issue tokens whose
# audience matches KEYCLOAK_AUDIENCE):
#   KEYCLOAK_DISCOVERY_URL=http://keycloak:8080/realms/moh-staff/.well-known/openid-configuration
#   KEYCLOAK_AUDIENCE=nhdw-gateway
#   DEV_AUTH=false
KEYCLOAK_DISCOVERY_URL=
KEYCLOAK_AUDIENCE=nhdw-gateway
KEYCLOAK_EXTRA_AUDIENCES=admin,workshop,internal-bi,submission-portal
DEV_AUTH=true

# OPA
OPA_URL=http://opa:8181
OPA_ENFORCE=false
