# OpenBao — secrets store + dynamic credential issuer.

# Data dir on the managed disk (holds the file-backed storage + audit logs).
OPENBAO_DATA_DIR=/data/security/openbao

# Postgres-vault admin credentials — used by the database secrets engine
# to create short-TTL roles for vault_writer / landing_writer / bi_reader
# consumers (JupyterHub, bridge job, analysts).
PG_VAULT_HOST=postgres-vault
PG_VAULT_PORT=5432
PG_VAULT_DATABASE=nhdw_vault
PG_VAULT_ADMIN_USER=vault_admin
# Pull from 3_storage/postgres/.env  POSTGRES_ADMIN_PASSWORD.
PG_VAULT_ADMIN_PASSWORD=changeme-from-4_storage-postgres-env

# ClickHouse admin (for the staging engine — issuing short-TTL CH roles
# becomes relevant when researchers start using JupyterHub).
CH_HOST=clickhouse
CH_PORT=8123
CH_ADMIN_USER=default
CH_ADMIN_PASSWORD=

# Initial root token persisted here on first bootstrap. ROTATE before any
# non-dev use.
ROOT_TOKEN_FILE=/var/lib/openbao/root-token
