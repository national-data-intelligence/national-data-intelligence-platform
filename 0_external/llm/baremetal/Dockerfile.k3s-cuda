# nhdw/k3s-cuda — a k3s NODE image with the NVIDIA Container Toolkit baked in, so
# the k3d cluster can actually SCHEDULE GPU workloads (the stock rancher/k3s node
# has no toolkit → containerd has no `nvidia` runtime → the k8s device-plugin
# reports "No devices found" and nvidia.com/gpu is never advertised).
#
# WHY a custom node image (proven empirically 2026-07-06): on this host the NVIDIA
# runtime is provided by Docker Desktop *internally* — there are NO toolkit binaries
# on the host filesystem to bind-mount into the node. The only reproducible,
# offline-bundleable fix is to bake the toolkit into the node image itself.
#
# HOW it works end to end:
#   1. `k3d cluster create --gpus all --image nhdw/k3s-cuda:dev` makes Docker
#      (Docker Desktop's `nvidia` runtime) inject the GPU into the NODE container —
#      on WSL2 that is /dev/dxg + the driver libs from /usr/lib/wsl/lib (there is
#      NO /dev/nvidia0 under WSL2; the toolkit auto-detects WSL mode).
#   2. Inside the node, k3s AUTO-DETECTS the nvidia-container-runtime baked here
#      and adds an `nvidia` runtime to its containerd config on startup.
#   3. The NVIDIA k8s device-plugin DaemonSet (run with runtimeClassName: nvidia)
#      enumerates the GPU and advertises `nvidia.com/gpu`, which nhdw-llm requests.
#
# The GPU DRIVER/CUDA libraries are NOT baked here — they come from the host at
# runtime (WSL driver libs via --gpus all), and the ollama pod ships its own CUDA
# userspace. This keeps the node image small and driver-version-agnostic.
#
# Build (needs network once; then cache-images.sh saves it into bundle/images):
#   docker build -f 0_external/llm/baremetal/Dockerfile.k3s-cuda -t nhdw/k3s-cuda:dev 0_external/llm/baremetal
ARG K3S_TAG=v1.35.5-k3s1

FROM rancher/k3s:${K3S_TAG} AS k3s

FROM ubuntu:24.04

# NVIDIA Container Toolkit (nvidia-container-runtime + hook + libnvidia-container).
# libnvidia-container detects WSL2 (via /dev/dxg) and mounts the WSL driver libs
# into each GPU pod, so no CUDA base image is needed here.
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl gnupg2 ca-certificates \
 && curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey \
      | gpg --dearmor -o /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg \
 && curl -fsSL https://nvidia.github.io/libnvidia-container/stable/deb/nvidia-container-toolkit.list \
      | sed 's#deb https://#deb [signed-by=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg] https://#g' \
      > /etc/apt/sources.list.d/nvidia-container-toolkit.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends nvidia-container-toolkit \
 && rm -rf /var/lib/apt/lists/*

# Overlay the k3s runtime (binaries, /bin busybox, manifests) on top. Ordered
# AFTER the toolkit install so the toolkit's /usr/bin/nvidia-container-* survive.
COPY --from=k3s / /

VOLUME /var/lib/kubelet
VOLUME /var/lib/rancher/k3s
VOLUME /var/lib/cni
VOLUME /var/log

# PATH MUST match the stock rancher/k3s image, NOT ubuntu's default. In
# particular it needs /bin/aux (k3s's bundled iptables-save/iptables-restore,
# used by k3d's DNS-fix entrypoint) and the CNI dir — dropping them makes the
# node crash-loop at boot with "iptables-save: not found" (empty logs, because
# the failure is in k3d-entrypoint-dns.sh before k3s even starts).
ENV PATH="/var/lib/rancher/k3s/data/cni:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/bin/aux"
ENTRYPOINT ["/bin/k3s"]
CMD ["agent"]
