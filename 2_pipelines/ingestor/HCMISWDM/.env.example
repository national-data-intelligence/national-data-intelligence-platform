# HCMIS WDM ingestor — environment.

# ── HCMIS WDM SQL Server source (HCMISWDM database) ─────────────────────────
HCMISWDM_HOST=hcmiswdm-sqlserver
HCMISWDM_PORT=1433
HCMISWDM_DATABASE=HCMISWDM
# Reader user provisioned by 0_external/sources/HCMISWDM/scripts/restore.sh (sql login: nscd_reader).
HCMISWDM_USER=nscd_reader
HCMISWDM_PASSWORD=changeme-match-source-env-HCMISWDM_NSCD_READER_PASSWORD
HCMISWDM_DRIVER=ODBC Driver 18 for SQL Server
HCMISWDM_TRUST_SERVER_CERTIFICATE=yes
HCMISWDM_TIMEOUT=120

# ── MinIO data lake ─────────────────────────────────────────────────────────
MINIO_ENDPOINT=http://minio-datalake:9000
MINIO_REGION=et-addis-1
MINIO_ACCESS_KEY=nhdw_ingestor
MINIO_SECRET_KEY=changeme-must-match-data-lake-INGESTOR_SECRET_KEY
MINIO_RAW_BUCKET=nhdw-raw

# ── Pipeline identity ───────────────────────────────────────────────────────
DLT_PIPELINE_NAME=hcmiswdm
