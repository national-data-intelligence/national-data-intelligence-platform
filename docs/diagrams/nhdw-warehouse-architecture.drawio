  <diagram id="nhdw_wh_layered" name="NHDW · Warehouse Architecture">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ===== TITLE ===== -->
        <mxCell id="title" value="National Health Data Warehouse (NHDW) — Architecture &amp; Tech Stack" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#0F1F3C;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1200" height="34" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Federal Ministry of Health, Ethiopia · data flows left → right · every consumption request passes through Identity → Authorization → Audit (bottom band)" style="text;html=1;align=left;fontSize=12;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1400" height="22" as="geometry"/></mxCell>
        <mxCell id="legend" value="Flow legend:  ▆ green = data flow   ┄ dashed = orchestration / governance     |     Engines: PostgreSQL · ClickHouse · MinIO · Trino   Transform: dbt + AutomateDV   Move: dlt + Airflow" style="text;html=1;align=left;fontSize=11;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1500" height="20" as="geometry"/></mxCell>

        <!-- ===== LANE 1 · SOURCE ===== -->
        <mxCell id="L_src" value="① SOURCE SYSTEMS" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#0D47A1;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="300" height="560" as="geometry"/></mxCell>
        <mxCell id="s_dhis2" value="DHIS2&#10;Aggregate HMIS / ~20 programs&#10;PostgreSQL · REST API" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1565C0;fontSize=11;align=center;" vertex="1" parent="L_src"><mxGeometry x="15" y="45" width="270" height="88" as="geometry"/></mxCell>
        <mxCell id="s_emr" value="EthioEMR  ⚠ PHI&#10;Patient EMR (Bahmni/OpenMRS)&#10;MySQL · FHIR R4 export" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#C62828;strokeWidth=1.5;fontSize=11;align=center;" vertex="1" parent="L_src"><mxGeometry x="15" y="147" width="270" height="88" as="geometry"/></mxCell>
        <mxCell id="s_hcmis" value="HCMIS WDM (ex-Vitas)&#10;Commodities / warehouse (EPSS)&#10;SQL Server" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1565C0;fontSize=11;align=center;" vertex="1" parent="L_src"><mxGeometry x="15" y="249" width="270" height="88" as="geometry"/></mxCell>
        <mxCell id="s_mbrana" value="mBrana&#10;Vaccines / LLINs (eVRF), woreda&#10;SQL Server (HCMISWCloud)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1565C0;fontSize=11;align=center;" vertex="1" parent="L_src"><mxGeometry x="15" y="351" width="270" height="88" as="geometry"/></mxCell>
        <mxCell id="s_mfr" value="MFR — Master Facility Registry&#10;~68k facilities · the join key&#10;FHIR R4 (Location / Organization)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#283593;strokeWidth=1.5;fontSize=11;align=center;" vertex="1" parent="L_src"><mxGeometry x="15" y="453" width="270" height="88" as="geometry"/></mxCell>

        <!-- ===== LANE 2 · INGESTION ===== -->
        <mxCell id="L_ing" value="② INGESTION" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#E65100;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="355" y="110" width="225" height="560" as="geometry"/></mxCell>
        <mxCell id="i_dlt" value="dlt ingestors&#10;(Python 3.12, one-shot&#10;profile-gated containers)&#10;one folder per source" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;strokeWidth=1.5;fontSize=11;align=center;" vertex="1" parent="L_ing"><mxGeometry x="15" y="50" width="195" height="120" as="geometry"/></mxCell>
        <mxCell id="i_proto" value="Extract protocols&#10;• DHIS2 → REST&#10;• EthioEMR/MFR → FHIR&#10;  ($export / search)&#10;• HCMIS/mBrana → pyodbc&#10;  (SQL Server)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="L_ing"><mxGeometry x="15" y="200" width="195" height="135" as="geometry"/></mxCell>
        <mxCell id="i_out" value="Output → Parquet&#10;+ _manifest.json&#10;dlt watermarks persisted&#10;(incremental + full-refresh)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;fontSize=10;align=center;" vertex="1" parent="L_ing"><mxGeometry x="15" y="365" width="195" height="110" as="geometry"/></mxCell>

        <!-- ===== LANE 3 · DATA LAKE ===== -->
        <mxCell id="L_lake" value="③ DATA LAKE" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#6A1B9A;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="595" y="110" width="215" height="560" as="geometry"/></mxCell>
        <mxCell id="lk_minio" value="MinIO&#10;S3-compatible object store" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A1B9A;strokeWidth=1.5;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="L_lake"><mxGeometry x="15" y="48" width="185" height="62" as="geometry"/></mxCell>
        <mxCell id="lk_raw" value="nhdw-raw&#10;immutable · versioned" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8F0FC;strokeColor=#6A1B9A;fontSize=10;align=center;" vertex="1" parent="L_lake"><mxGeometry x="15" y="125" width="185" height="58" as="geometry"/></mxCell>
        <mxCell id="lk_proc" value="nhdw-processed&#10;dbt outputs · regenerable" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8F0FC;strokeColor=#6A1B9A;fontSize=10;align=center;" vertex="1" parent="L_lake"><mxGeometry x="15" y="195" width="185" height="58" as="geometry"/></mxCell>
        <mxCell id="lk_arch" value="nhdw-archive&#10;cold tier · 365-day TTL" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8F0FC;strokeColor=#6A1B9A;fontSize=10;align=center;" vertex="1" parent="L_lake"><mxGeometry x="15" y="265" width="185" height="58" as="geometry"/></mxCell>
        <mxCell id="lk_app" value="+ application buckets&#10;nhdw-exports&#10;nhdw-artifacts&#10;nhdw-ml-artifacts" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9C4DCC;dashed=1;fontSize=10;align=center;" vertex="1" parent="L_lake"><mxGeometry x="15" y="345" width="185" height="100" as="geometry"/></mxCell>

        <!-- ===== LANE 4 · WAREHOUSE / MODELING ===== -->
        <mxCell id="L_wh" value="④ WAREHOUSE &amp; DATA MODELING   (transform = dbt)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#1B5E20;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="825" y="110" width="440" height="560" as="geometry"/></mxCell>
        <mxCell id="w_stg" value="STAGING — ClickHouse&#10;dbt views over MinIO via s3() table fn · zero rows on disk · clean + typed" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;strokeWidth=1.5;fontSize=11;align=center;" vertex="1" parent="L_wh"><mxGeometry x="20" y="45" width="400" height="76" as="geometry"/></mxCell>
        <mxCell id="w_land" value="LANDING (PSA) — PostgreSQL&#10;bridge job: TRUNCATE + COPY (Python: clickhouse-driver → psycopg2)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;fontSize=11;align=center;" vertex="1" parent="L_wh"><mxGeometry x="20" y="131" width="400" height="76" as="geometry"/></mxCell>
        <mxCell id="w_raw" value="RAW VAULT — PostgreSQL · dbt + AutomateDV&#10;Data Vault 2.0: Hubs · Links · Satellites (SHA-256 keys + hashdiff) — full history, insert-only" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=11;align=center;" vertex="1" parent="L_wh"><mxGeometry x="20" y="217" width="400" height="76" as="geometry"/></mxCell>
        <mxCell id="w_biz" value="BUSINESS VAULT — PostgreSQL&#10;Conformed hubs · same-as links (pg_trgm) · Ethiopian-calendar derived sats — one truth across sources" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=11;align=center;" vertex="1" parent="L_wh"><mxGeometry x="20" y="303" width="400" height="76" as="geometry"/></mxCell>
        <mxCell id="w_marts" value="MARTS — PostgreSQL  bi_facility · bi_supply · bi_epi · bi_hmis · bi_idsr&#10;dbt flat denormalized aggregates (views; heavy ones = tables)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#1B5E20;strokeWidth=1.5;fontSize=11;align=center;" vertex="1" parent="L_wh"><mxGeometry x="20" y="389" width="400" height="76" as="geometry"/></mxCell>
        <mxCell id="w_pub" value="PUBLIC MARTS — bi_public&#10;k-anonymity enforced in SQL: HAVING count ≥ 5 · consent gate anti-join" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#1B5E20;strokeWidth=1.5;fontSize=11;align=center;" vertex="1" parent="L_wh"><mxGeometry x="20" y="475" width="400" height="70" as="geometry"/></mxCell>

        <!-- ===== LANE 5 · SERVING ===== -->
        <mxCell id="L_srv" value="⑤ SERVING" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#E0F7FA;strokeColor=#00838F;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#006064;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1280" y="110" width="245" height="560" as="geometry"/></mxCell>
        <mxCell id="sv_gw" value="nhdw-gateway&#10;(FastAPI) — THE single data door&#10;validates JWT → asks OPA → audits → queries" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00838F;strokeWidth=2;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="L_srv"><mxGeometry x="15" y="60" width="215" height="120" as="geometry"/></mxCell>
        <mxCell id="sv_trino" value="Trino&#10;federated SQL engine&#10;catalogs: marts (bi_*), ops (audit)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00838F;fontSize=11;align=center;" vertex="1" parent="L_srv"><mxGeometry x="15" y="220" width="215" height="100" as="geometry"/></mxCell>
        <mxCell id="sv_mlf" value="MLflow&#10;model registry + tracking&#10;meta in PostgreSQL · artifacts in MinIO" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00838F;fontSize=11;align=center;" vertex="1" parent="L_srv"><mxGeometry x="15" y="360" width="215" height="100" as="geometry"/></mxCell>

        <!-- ===== LANE 6 · CONSUMPTION ===== -->
        <mxCell id="L_con" value="⑥ ACCESS / CONSUMPTION" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FCE4EC;strokeColor=#AD1457;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#880E4F;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1540" y="110" width="420" height="560" as="geometry"/></mxCell>
        <mxCell id="c_pub" value="Public Dashboard  :8088   ·  anonymous, k-anon tiles" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AD1457;fontSize=11;align=center;" vertex="1" parent="L_con"><mxGeometry x="15" y="45" width="390" height="64" as="geometry"/></mxCell>
        <mxCell id="c_ibi" value="Internal BI  :8087   ·  OIDC, manifest-driven, ECharts" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AD1457;fontSize=11;align=center;" vertex="1" parent="L_con"><mxGeometry x="15" y="119" width="390" height="64" as="geometry"/></mxCell>
        <mxCell id="c_sub" value="Submission Portal  :8089   ·  R-PROD-SUBMIT uploads → OpenHIM" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AD1457;fontSize=11;align=center;" vertex="1" parent="L_con"><mxGeometry x="15" y="193" width="390" height="64" as="geometry"/></mxCell>
        <mxCell id="c_jh" value="JupyterHub  :8096   ·  notebooks, per-spawn OpenBao creds" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AD1457;fontSize=11;align=center;" vertex="1" parent="L_con"><mxGeometry x="15" y="267" width="390" height="64" as="geometry"/></mxCell>
        <mxCell id="c_ml" value="ML Serving API  :8098   ·  /predict (Bearer JWT)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AD1457;fontSize=11;align=center;" vertex="1" parent="L_con"><mxGeometry x="15" y="341" width="390" height="64" as="geometry"/></mxCell>
        <mxCell id="c_sql" value="CloudBeaver  :8086  +  dbt Docs  :8097   ·  SQL IDE / lineage" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AD1457;fontSize=11;align=center;" vertex="1" parent="L_con"><mxGeometry x="15" y="415" width="390" height="64" as="geometry"/></mxCell>
        <mxCell id="c_ops" value="Ops Hub :8085  ·  FHIR API :8093 (HAPI)  ·  OpenHIM :8095" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AD1457;fontSize=11;align=center;" vertex="1" parent="L_con"><mxGeometry x="15" y="489" width="390" height="64" as="geometry"/></mxCell>

        <!-- ===== BAND · ORCHESTRATION ===== -->
        <mxCell id="B_orch" value="ORCHESTRATION   ·   Apache Airflow 2.10.4 (LocalExecutor) — DAGs shell one-shot ingestor containers via docker.sock; schedule-based cascade (no cross-DAG sensors)" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#ECEFF1;strokeColor=#455A64;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#263238;verticalAlign=top;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="715" width="1920" height="86" as="geometry"/></mxCell>
        <mxCell id="o_ing" value="INGEST&#10;dhis2 hourly · ethioemr 02:00 · mfr 03:45 · hcmis :30 · mbrana :15" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#455A64;fontSize=10;align=center;" vertex="1" parent="B_orch"><mxGeometry x="15" y="36" width="440" height="42" as="geometry"/></mxCell>
        <mxCell id="o_cas" value="TRANSFORM CASCADE&#10;staging 03:30 → vault 04:30 (bridge+dbt) → marts 05:00" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#455A64;fontSize=10;align=center;" vertex="1" parent="B_orch"><mxGeometry x="475" y="36" width="460" height="42" as="geometry"/></mxCell>
        <mxCell id="o_con" value="GOVERNANCE / RUNTIME&#10;consent_extract (5 min) · saved_query_runner (15 min, paused)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#455A64;fontSize=10;align=center;" vertex="1" parent="B_orch"><mxGeometry x="955" y="36" width="470" height="42" as="geometry"/></mxCell>
        <mxCell id="o_prom" value="MANUAL GATES&#10;marts_promote · ml_promote_to_staging (approval + audit)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#455A64;fontSize=10;align=center;" vertex="1" parent="B_orch"><mxGeometry x="1445" y="36" width="460" height="42" as="geometry"/></mxCell>

        <!-- ===== BAND · SECURITY & GOVERNANCE ===== -->
        <mxCell id="B_sec" value="SECURITY &amp; GOVERNANCE   ·   every door is OIDC-gated → policy-checked → audited" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#FFFDE7;strokeColor=#F9A825;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#7A5C00;verticalAlign=top;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="1920" height="150" as="geometry"/></mxCell>
        <mxCell id="sec_kc" value="Keycloak  (SSO / IdP)&#10;2 staff realms: moh-staff ·&#10;privileged-ops&#10;issues signed JWT (flat roles)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F9A825;strokeWidth=1.5;fontSize=10;align=center;" vertex="1" parent="B_sec"><mxGeometry x="18" y="40" width="365" height="95" as="geometry"/></mxCell>
        <mxCell id="sec_opa" value="OPA  (PDP / authorization)&#10;package nhdw.authz · default-deny&#10;13 roles compiled from YAML → Rego&#10;returns allow + masked columns" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F9A825;strokeWidth=1.5;fontSize=10;align=center;" vertex="1" parent="B_sec"><mxGeometry x="401" y="40" width="365" height="95" as="geometry"/></mxCell>
        <mxCell id="sec_bao" value="OpenBao  (secrets)&#10;KV-v2 + database engine&#10;short-TTL DB creds: writers 1h/4h,&#10;readers 4h/8h · break-glass" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F9A825;strokeWidth=1.5;fontSize=10;align=center;" vertex="1" parent="B_sec"><mxGeometry x="784" y="40" width="365" height="95" as="geometry"/></mxCell>
        <mxCell id="sec_loki" value="Loki  (audit)&#10;every data read → FHIR&#10;AuditEvent · append-only&#10;1-year retention" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F9A825;strokeWidth=1.5;fontSize=10;align=center;" vertex="1" parent="B_sec"><mxGeometry x="1167" y="40" width="365" height="95" as="geometry"/></mxCell>
        <mxCell id="sec_fayda" value="Fayda Replica  (dev)&#10;mock national-ID OIDC&#10;access-request verification&#10;→ real Fayda in prod" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F9A825;strokeWidth=1.5;dashed=1;fontSize=10;align=center;" vertex="1" parent="B_sec"><mxGeometry x="1550" y="40" width="355" height="95" as="geometry"/></mxCell>

