# MFR ingestor — environment.
# Copy to .env (gitignored) and fill in the changeme- values.

# ── MFR FHIR R4 source ──────────────────────────────────────────────────────
# The Master Facility Registry FHIR server. /Location = facilities,
# /Organization = owners. Base URL is everything BEFORE /Location.
MFR_FHIR_BASE_URL=https://fhir-mfr.moh.gov.et/fhir

# Auth — leave blank for an unauthenticated endpoint.
#   HTTP Basic:  set MFR_FHIR_USER / MFR_FHIR_PASSWORD
#   Bearer/OAuth: set MFR_FHIR_TOKEN (takes precedence over user/password)
MFR_FHIR_USER=
MFR_FHIR_PASSWORD=
MFR_FHIR_TOKEN=

# ── MFR API behavior ────────────────────────────────────────────────────────
# FHIR Bundle page size (_count). 200 is a safe default.
MFR_FHIR_PAGE_SIZE=200
# Request timeout (seconds).
MFR_FHIR_TIMEOUT=120
# Max Bundle pages to follow. 0 = unbounded — drain the whole registry (this is
# what production wants: "pull consistently until it finishes"). Set a small
# value for smoke/dev runs.
MFR_FHIR_MAX_PAGES=0
# ISO 8601 floor on FHIR _lastUpdated. Empty = full registry pull (default;
# correct for a slow-moving facility dimension). Set e.g. 2026-01-01 for an
# incremental delta.
MFR_FHIR_SINCE=
# Dev cap: stop after N rows per resource. 0 = unbounded.
MFR_DEV_MAX_ROWS=0

# ── MinIO data lake ─────────────────────────────────────────────────────────
# Endpoint = the in-cluster SeaweedFS S3 gateway (Service seaweedfs-s3, port 8333).
MINIO_ENDPOINT=http://seaweedfs-s3.nhdw.svc.cluster.local:8333
MINIO_REGION=et-addis-1
MINIO_ACCESS_KEY=nhdw_ingestor
MINIO_SECRET_KEY=changeme-must-match-data-lake-INGESTOR_SECRET_KEY
MINIO_RAW_BUCKET=nhdw-raw

# ── Pipeline identity ───────────────────────────────────────────────────────
# Prefixes dlt's internal state and shows up in _manifest.json sidecars.
DLT_PIPELINE_NAME=mfr
