# CH→PG bridge — reads CH staging, writes PG landing.

# ── ClickHouse source (native TCP 9000, NOT HTTP) ─────────────────────────
CH_HOST=clickhouse
CH_PORT=9000
CH_USER=staging_writer
# Pull from 3_storage/clickhouse/.env  CLICKHOUSE_STAGING_PASSWORD.
CH_PASSWORD=changeme-clickhouse-staging-password

# ── Postgres target ───────────────────────────────────────────────────────
PG_HOST=postgres-vault
PG_PORT=5432
PG_DATABASE=nhdw_vault
PG_USER=landing_writer
# Pull from 3_storage/postgres/.env  LANDING_WRITER_PASSWORD.
PG_PASSWORD=changeme-pg-landing-writer-password
PG_SCHEMA=nhdw_landing

# ── Tuning ────────────────────────────────────────────────────────────────
BATCH_SIZE=50000
