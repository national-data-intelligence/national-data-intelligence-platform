# ============================================================
# Backup repo policy: track EVERYTHING except secrets and
# regenerable/re-downloadable artifacts. Large binaries are
# stored via Git LFS (see .gitattributes).
# ============================================================

# --- Secrets (NEVER back up) ---
.env
.env.*
!.env.example
# Fayda replica's isolated SMTP config: the real .env stays ignored (.env rule
# above), but its placeholder template is committed as living documentation.
!0_external/fayda/.env.template
*.pem
*.key
*.p12
*.pfx
credentials.json
# Local workspace holding real credentials (GCP service-account keys, etc.) — NEVER commit
_workspace/
*-service-account*.json
secrets/
**/secrets.yaml
**/secrets.yml
dhis.conf
standalone_admin_password.txt
# Airflow config can embed connection secrets
airflow.cfg
config/airflow.cfg
config/webserver_config.py

# --- Regenerable dependencies / build output / caches ---
node_modules/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version
.ipynb_checkpoints/
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Large re-downloadable third-party app (excluded per backup plan) ---
0_external/sources/DHIS2/war/
# QAT (Quantification Analytics Tool) evaluation bundle — external tool studied
# for the supply-chain integration plan (docs/qat-integration-plan.md); large,
# not part of NHDW.
qat-full-stack.zip

# --- Runtime pids / sockets ---
*.pid
*.seed
airflow-webserver.pid
airflow.db

# --- OS / editor cruft ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Phase 5.2: NHDW PKI material — issued per-host, never commit private keys
7_security/pki/certs/

# --- Packaging artifacts (regenerated by snapshot.sh / bundle-images.sh) ---
bundle/seeds/_cache/
bundle/images/

# Pre-baked image tars — large, regenerable from Dockerfiles via cache-images.sh
bundle/images/*.tar
# LLM weight store — the external ollama's mounted .ollama home (large; ships in the
# bundle zip, regenerable via 0_external/llm/image/fetch-weights.sh). Moved out of
# bundle/ollama 2026-07-06 when the LLM became an external 0_external/ component.
0_external/llm/models/
0_external/llm/models/id_ed25519*
# bundled static tooling (mc — fetched once, ships in the bundle like the weights)
bundle/bin/
# machine-exported runtime state (written by pack.sh; factory bundles have none)
bundle/state/
.gstack/

# staged copy of the graduation validator harness (canonical: 2_pipelines/ml/registry/validators.py)
6_access-points/api/nhdw-gateway/validators.py

# local TLS CA + wildcard cert (gen-tls.sh) — never commit private keys
bundle/tls/


# archived local image-cache tars (regenerable; not source)
_archive/**/images/*.tar

# transient reactivity-harness run outputs (probe.py + README are the tool)
_tools/reactivity-harness/report*.md
_tools/reactivity-harness/report*.json
# bun install lockfiles in SPA ui dirs (npm is canonical in CI)
6_access-points/dashboards/*/ui/bun.lock

# --- Source seed data — large demo dumps, NOT published to the public repo ---
# The sources come up EMPTY without these; provide them locally to populate the
# demo (see each 0_external/sources/*/sample-data/README). Regenerable by
# re-running the source systems + bundle/scripts/pack.sh, or obtained separately.
0_external/sources/*/sample-data/*.sql
0_external/sources/*/sample-data/*.bak
0_external/sources/*/sample-data/*.pgdump
0_external/sources/*/sample-data/*.dump
0_external/sources/*/sample-data/*.sql.gz
0_external/sources/*/sample-data/*.gz

# --- dbt / tool run logs (never belong in version control) ---
**/logs/*.log
**/logs/*.log.*
2_pipelines/*/logs/

# --- Bulk source seed CSVs — demo seed data, excluded from the public repo
# (read by seed-realistic.sh; supply locally to populate, same as sample-data) ---
bundle/seeds/sources/**/*.csv
bundle/seeds/sources/*.csv

# --- Design reference mockups dropped into the tree while iterating on the
#     dashboards — never part of the shipped repo. ---
ChatGPT Image*.png
*Redesign*.png

# --- excluded from the published repo (dev archive, dev tooling, dbt build
#     artifacts, and the bulk entity-model seed data) ---
_archive/
_tools/
2_pipelines/*/target/
2_pipelines/*/dbt_packages/
bundle/seeds/entity-model/sample-data/
client_secret_*.json

# Local data landmines / raw import artifacts — never commit
*.bak.bloated-orig
supply-control-tower.zip
*.apps.googleusercontent.com.json

# ── palladium-console ───────────────────────────────────────────────────────
# A SEPARATE product: a Palladium-wide console that drives many projects, of
# which NHDW is one. It lives here only while it is being built and carries its
# own git history — it must never enter this repo's.
# (Not to be confused with bundle/demo-console/, which IS part of NHDW — that is
# this deployment's operator cockpit.)
#
# Anchored to the repo root on purpose. An unanchored `palladium-console/` also
# matches nested copies, which silently emptied the one-off _deploy-once courier
# — it staged its README and nothing else.
/palladium-console/

# Private SSH material. Never commit — this repo is public.
.ssh.rar
.ssh/
*.pem
