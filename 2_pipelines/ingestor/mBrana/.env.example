# mBrana ingestor — environment.

# ── mBrana SQL Server source (HCMISWCloud) ──────────────────────────────────
# In-network — points at 0_external/sources/mBrana/ on nhdw_net.
MBRANA_HOST=mbrana-sqlserver
MBRANA_PORT=1433
MBRANA_DATABASE=HCMISWCloud
MBRANA_USER=sa
MBRANA_PASSWORD=changeme-match-source-env-MBRANA_SA_PASSWORD

# Driver. msodbcsql18 is bundled in the image.
MBRANA_DRIVER=ODBC Driver 18 for SQL Server
# Self-signed cert in dev — disable strict TLS validation in-network.
MBRANA_TRUST_SERVER_CERTIFICATE=yes
MBRANA_TIMEOUT=120

# ── MinIO data lake ─────────────────────────────────────────────────────────
MINIO_ENDPOINT=http://minio-datalake:9000
MINIO_REGION=et-addis-1
MINIO_ACCESS_KEY=nhdw_ingestor
MINIO_SECRET_KEY=changeme-must-match-data-lake-INGESTOR_SECRET_KEY
MINIO_RAW_BUCKET=nhdw-raw

# ── Pipeline identity ───────────────────────────────────────────────────────
DLT_PIPELINE_NAME=mbrana
