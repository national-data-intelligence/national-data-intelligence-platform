      "title": "SYNTHETIC \u2014 Current high-risk woredas (latest week, alarm_flag=1)",
      "description": "Woredas flagged in the most recent week of the latest synthetic run, sorted by alarm probability.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bfp40bxmh7i0wa"
          },
          "rawSql": "SELECT c.adm3_name AS \"Woreda\", c.adm1_name AS \"Region\", p.week AS \"Week\",\n  round(p.alarm_prob,3) AS \"Alarm prob\",\n  round(p.pred_cases_mean,1) AS \"Pred mean\",\n  round(p.alarm_threshold,1) AS \"Threshold\"\nFROM ewars.ewars_predictions p\nJOIN ewars.pilot_woreda_crosswalk c ON c.district_id=p.district\nWHERE p.data_provenance='synthetic' AND p.run_id=(SELECT max(run_id) FROM ewars.ewars_predictions WHERE data_provenance='synthetic') AND p.alarm_flag=1\n  AND p.week=(SELECT max(week) FROM ewars.ewars_predictions\n              WHERE data_provenance='synthetic' AND run_id=(SELECT max(run_id) FROM ewars.ewars_predictions WHERE data_provenance='synthetic'))\nORDER BY p.alarm_prob DESC",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "filterable": true
          }
